# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── Reality "self-steal" ──
# By default the Reality fallback target is reality_settings.server_name:443.
# When server_name is your own domain pointing at this machine, that target is
# the node itself and the fallback loops. Serve the domain from a local web
# server with a valid certificate and point the fallback at it instead:
# kernel:
#   reality_dest: "127.0.0.1:8443"   # or env REALITY_DEST; per node: nodes[].kernel.reality_dest
